{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pdc:document:envelope:1",
  "title": "Portable Document Contract 1 parsed envelope",
  "description": "Validates the data model after the constrained envelope grammar has been parsed. It does not validate the text grammar or Writer-only UUIDv7 rule.",
  "type": "object",
  "required": ["format", "body", "id", "created", "updated", "title"],
  "allOf": [
    {
      "if": {
        "required": ["deleted"],
        "properties": { "deleted": { "const": true } }
      },
      "then": { "required": ["deleted_at"] }
    },
    {
      "if": { "required": ["deleted_at"] },
      "then": {
        "required": ["deleted"],
        "properties": { "deleted": { "const": true } }
      }
    }
  ],
  "properties": {
    "format": { "const": "pdc-document/1" },
    "body": { "const": "pdc-djot/1" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created": { "$ref": "#/$defs/timestamp" },
    "updated": { "$ref": "#/$defs/timestamp" },
    "title": { "type": "string" },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "lang": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "favorite": { "type": "boolean" },
    "deleted": { "type": "boolean" },
    "deleted_at": { "$ref": "#/$defs/timestamp" }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9]*$": { "$ref": "#/$defs/extensionMap" }
  },
  "additionalProperties": { "$ref": "#/$defs/value" },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        { "$ref": "#/$defs/stringArray" }
      ]
    },
    "extensionMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "value": {
      "oneOf": [
        { "$ref": "#/$defs/scalar" },
        { "$ref": "#/$defs/extensionMap" }
      ]
    }
  }
}
